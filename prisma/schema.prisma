// Prisma schema, JobRifa
//
// Decisões importantes (documentação inline para Mateus aprender no caminho):
//
// 1) LAZY TICKET MODEL: a tabela `Ticket` NÃO recebe uma linha por número quando
//    a rifa é criada. Uma rifa de 1.000.000 de números criaria 1M de linhas inúteis
//    no banco. Em vez disso, só inserimos uma linha quando o número é reservado
//    ou pago. A ausência de linha = número AVAILABLE. O `@@unique([raffleId, number])`
//    funciona como o "lock" que impede dois clientes de reservarem o mesmo número
//    ao mesmo tempo, o segundo INSERT falha com erro de constraint.
//
// 2) RESERVATION guarda os dados do participante mesmo se ele não tiver conta.
//    A relação com User é opcional (`userId?`) para permitir compras anônimas
//    que apenas exigem nome/CPF/telefone.
//
// 3) PaymentWebhookEvent garante idempotência: se o Mercado Pago disparar o mesmo
//    webhook 2x, conseguimos detectar via `@@unique([provider, externalId])` e
//    pular o processamento duplicado.
//
// 4) Todos os Decimal usam @db.Decimal(10,2) (até R$ 99.999.999,99), suficiente
//    para qualquer rifa realista, evita problemas de ponto flutuante.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  SUPER_ADMIN // dono da plataforma, vê todos os tenants
  ADMIN // dono de um tenant, vê só os sorteios do tenant dele
  AFFILIATE
  PARTICIPANT
}

// Multi-tenant: cada Tenant é um "cliente da plataforma". Mateus = 1 tenant,
// André = outro tenant, etc. Os sorteios pertencem ao tenant, o domínio
// roteia pra ele e o admin do tenant só vê o que é dele.
// Formato da logo no cabeçalho. Decide o recorte, e recorte errado destrói
// a marca: uma logo em faixa ("SKINS LENDÁRIAS") dentro de um círculo perde
// as pontas, e um emblema redondo numa caixa larga fica flutuando no vazio.
// Quem envia a imagem sabe qual é o caso; o site não tem como adivinhar.
enum LogoShape {
  ROUND // emblema/avatar: recorta em círculo
  RECTANGLE // faixa/wordmark: cabe inteira, sem recorte
}

enum TenantHostKind {
  PUBLIC // host onde o site público do tenant é servido (sorteios.vip)
  ADMIN // host onde o painel admin do tenant é servido (admin.sorteios.vip)
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  FINISHED
  CANCELLED
}

enum RafflePrivacy {
  PUBLIC
  PRIVATE
}

enum ReservationModel {
  RANDOM_NUMBERS // sistema sorteia números aleatórios para o participante
  SEQUENTIAL // números sequenciais
  MANUAL // participante escolhe os números
}

enum RaffleModality {
  LOTERIA_FEDERAL // sorteio baseado no resultado da Loteria Federal
  OWN_DRAW // sorteio próprio com semente verificável
}

/// Fases do sorteio ao vivo. A ordem aqui é a ordem em que acontecem.
/// Em que pé está a entrega da skin ao ganhador.
///
/// Era um booleano disfarçado: `deliveredAt` nulo ou preenchido. Isso conta
/// duas histórias e a fila tem mais do que duas: skin que precisa sair na
/// frente, compra que deu errado, envio que precisa ser refeito, e prêmio pago
/// em dinheiro em vez de item.
enum DeliveryStatus {
  PRIORIDADE // sai na frente das outras
  AGUARDANDO // estado inicial de toda campanha sorteada
  ENVIADO // a oferta saiu e o ganhador recebeu
  ERRO // a compra ou a troca falhou; exige olho humano
  REENVIO // saiu, voltou, precisa sair de novo
  PIX // pago em dinheiro, e não em skin
}

enum DrawStatus {
  WAITING_DRAW // campanha encerrada, esperando a hora marcada
  COUNTDOWN // os segundos finais, contando na tela
  DRAWING // o motor escolheu (ou está escolhendo) o número
  REVEALING // o número é público, o nome ainda não
  FINISHED // resultado completo e permanente
  ERROR // não foi possível sortear; exige olho humano
}

enum TicketStatus {
  RESERVED // reservado, aguardando pagamento
  PAID // pago
  AWARDED // premiado
  // Nota: não existe AVAILABLE, modelo lazy, ausência de linha = disponível
}

enum ReservationStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

enum PaymentProvider {
  MERCADO_PAGO
  SYNCPAY
  CODEPAY
  SIGILOPAY
  NEXUSPAG
}

enum CommissionStatus {
  PENDING
  PAID
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
}

enum DescriptionMode {
  EXPANDED // descrição sempre visível
  COLLAPSED // descrição aparece num <details> recolhido
}

enum ThemeMode {
  LIGHT
  DARK
}

// =====================================================================
// USUÁRIOS E AUTENTICAÇÃO (compatível com Auth.js v5 + Prisma Adapter)
// =====================================================================

model User {
  id                 String    @id @default(cuid())
  // E-mail é opcional, o login do app é por nome + celular, sem senha.
  // Mantemos o campo (e o unique) por compatibilidade com o Prisma Adapter
  // do Auth.js e pra eventual recuperação/contato. Múltiplos NULLs são
  // permitidos pelo Postgres em colunas unique.
  email              String?   @unique
  emailVerified      DateTime?
  // Senha só existe para quem opera o painel. Participante continua entrando
  // por nome + celular, sem senha: é o fluxo do site público, e pedir senha
  // ali derrubaria conversão. Admin é o contrário, a conta comanda dinheiro
  // e dados de terceiros, e nome + celular são públicos demais para proteger
  // isso.
  passwordHash       String?
  // Marca senha temporária: o painel obriga a trocar antes de liberar
  // qualquer outra tela. Serve ao primeiro acesso e a resets.
  mustChangePassword Boolean   @default(false)

  /// Mostra o selo de moderador ao lado do nome.
  ///
  /// Interruptor por pessoa, e não algo derivado do papel, porque cargo e
  /// aparência pública são decisões separadas: existe admin que precisa
  /// passar por cliente comum, e pode existir moderador que não é admin.
  showModBadge Boolean @default(false)
  name         String
  // CPF não é mais usado pra login (passou a ser nome+celular). Continua
  // como campo opcional pra dados antigos e edição via admin. Múltiplos
  // NULLs são OK no @unique.
  cpf          String? @unique
  // Celular é o identificador único do login (combinado com nome). Armazenado
  // SOMENTE em dígitos. Continua opcional pra contas legadas, mas usuários
  // novos sempre cadastram.
  phone        String? @unique
  // País do telefone, em ISO 3166-1 alfa-2. O número continua guardado só em
  // dígitos e sem o código do país: assim as contas que já existem seguem
  // válidas sem migração de dados, e a formatação sabe de que país o número
  // é na hora de exibir.
  phoneCountry String  @default("BR")
  role         Role    @default(PARTICIPANT)
  image        String?

  /// O time de CS2 para quem a pessoa torce, exibido ao lado do nome dela.
  ///
  /// Guarda o id da lista de src/lib/times-cs2.ts, e não uma chave estrangeira:
  /// os times moram em código porque são uma lista curta e estável que ninguém
  /// cadastra pelo painel. Sem FK, um time que saia da lista deixa aqui um id
  /// órfão, e é de propósito: `timePorId` devolve nulo e a pessoa só deixa de
  /// exibir time, em vez de a página quebrar.
  favoriteTeamId String?

  // Link de troca da Steam, é por ele que a skin ganha é entregue.
  // Formato: https://steamcommunity.com/tradeoffer/new/?partner=...&token=...
  steamTradeUrl String?
  steamId       String?

  // Multi-tenant: ADMIN e AFFILIATE pertencem a 1 tenant (membership).
  // SUPER_ADMIN e PARTICIPANT são globais, não pertencem a nenhum tenant
  // específico (PARTICIPANT pode comprar em qualquer um, SUPER_ADMIN vê
  // todos no painel). Por isso o campo é nullable.
  tenantId String?
  tenant   Tenant? @relation("TenantMembers", fields: [tenantId], references: [id], onDelete: SetNull)

  // Quem é dono do tenant. 1:1, cada User pode ser dono de no máximo 1
  // tenant (geralmente o ADMIN/SUPER_ADMIN principal). Setado quando o
  // tenant é criado.
  ownedTenant Tenant? @relation("TenantOwner")

  /// Quem indicou esta conta. Vínculo permanente: entra uma vez, no
  /// cadastro (ou quando a pessoa aplica um código pela primeira vez), e
  /// nunca troca. Sem isso, um segundo link roubaria o indicado do primeiro
  /// afiliado, e a conta de quem indicou passaria a depender de quem mandou
  /// o último link.
  referredByAffiliateId String?
  referredByAffiliate   Affiliate?              @relation("IndicadosDoAfiliado", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  qualificacao          QualificacaoDeIndicado?

  accounts       Account[]
  sessions       Session[]
  reservations   Reservation[]
  xpEntries      XpEntry[]
  boostEntries   BoostEntry[]
  progress       UserProgress[]
  affiliate      Affiliate?
  createdRaffles Raffle[]       @relation("CreatedRaffles")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([tenantId])
  @@index([referredByAffiliateId])
}

// Tenant é o "cliente" da plataforma, cada admin que comprou domínio próprio
// e configurou apontamento DNS pra cá vira um Tenant. Slug é só identificador
// interno (não aparece em URLs). Identidade externa = os hosts cadastrados.
model Tenant {
  id      String @id @default(cuid())
  slug    String @unique // identificador interno: "mateus", "andre", ...
  name    String // nome de exibição: "Sorteios VIP", "Skins Lendárias"
  ownerId String @unique
  owner   User   @relation("TenantOwner", fields: [ownerId], references: [id])

  // Provider de PIX ativo + credenciais por gateway. Cada tenant configura
  // o dele no painel admin; credenciais sensíveis (secret/password) são
  // gravadas encriptadas (AES-256-GCM com chave em PAYMENT_SECRET_ENCRYPTION_KEY).
  // Quando o campo aqui está NULL, o lib client cai pro env var legado
  // (SYNCPAY_CLIENT_ID/SECRET), backwards compat com o setup atual.
  paymentProvider          PaymentProvider @default(SYNCPAY)
  syncpayClientId          String?
  syncpayClientSecretEnc   String?
  syncpayBaseUrl           String?
  codepayClientId          String?
  codepayPasswordEnc       String?
  sigilopayClientId        String?
  sigilopayClientSecretEnc String?
  sigilopayBaseUrl         String?
  nexuspagApiKeyEnc        String?
  /// Segredo do webhook da NexusPag, do painel deles. Sem ele a plataforma
  /// nao assina a notificacao, e a rota recusa tudo: pagamento confirmado por
  /// quem nao provou ser a NexusPag e a porta aberta mais cara do sistema.
  nexuspagWebhookSecretEnc String?
  nexuspagBaseUrl          String?

  // Customização das páginas finais (pagamento confirmado / reserva
  // expirada). Quando NULL, renderiza o texto padrão hardcoded. Cada
  // tenant configura no admin em /configuracoes/mensagens.
  paidTitle         String?
  paidDescription   String? @db.Text
  paidButtonLabel   String?
  paidImageUrl      String?
  // Selo automático do card da campanha, por faixa de vendas.
  //
  // Antes o selo era digitado por campanha e ficava congelado: "Adquira já"
  // continuava lá com 95% vendido, e uma campanha esgotada seguia chamando
  // para comprar número que não existia mais. Agora a urgência acompanha a
  // venda sozinha.
  //
  // Texto nulo cai no padrão em lib/campanha-status.ts.
  /// Texto do selo enquanto a venda ainda não chegou na metade.
  ///
  /// É automático como os outros três. Já foi um campo por campanha, e ali
  /// alguém escreveu "corre que está acabando", que apareceu com zero
  /// vendido: urgência é conclusão sobre a venda, e conclusão o sistema tira.
  earlyText         String?
  halfwayText       String?
  almostGoneText    String?
  soldOutText       String?
  /// A partir de quantos por cento cada selo entra.
  halfwayPercent    Int     @default(50)
  almostGonePercent Int     @default(80)

  expiredTitle       String?
  expiredDescription String? @db.Text
  expiredButtonLabel String?
  expiredImageUrl    String?

  // Identidade visual e textos do site (antes singleton em SiteSettings).
  // Cada tenant edita os próprios em Admin → Configurações / Personalizar
  // tema. Quando vazio/NULL, o componente cai num fallback razoável.
  logoUrl           String?
  // Ícone da aba do navegador. Separado da logo de propósito: a logo é uma
  // faixa larga, e o favicon é lido a 16px, a mesma imagem nos dois lugares
  // vira um borrão na aba. Quando vazio, cai na logo.
  faviconUrl        String?
  // Arte de fundo das telas de entrar e criar conta. Fica no Tenant e não
  // num arquivo do repositório porque é escolha de marca de cada site, e
  // trocar arte não pode depender de deploy.
  authBackgroundUrl String?

  /// O TROFÉU PADRÃO DA TELA DE SORTEIO.
  ///
  /// Aparece ao lado de "Número sorteado" em TODA campanha, porque é elemento
  /// de marca e não de campanha: quem assiste vê a mesma cena toda semana.
  /// `Raffle.trofeuUrl` continua existindo e ganha de quem quiser variar numa
  /// campanha específica; vazio nos dois lugares não desenha nada.
  trofeuUrl         String?

  // RECTANGLE é o padrão porque nunca corta: encaixa a imagem inteira seja
  // qual for a proporção. ROUND é escolha explícita de quem tem um emblema.
  logoShape         LogoShape @default(RECTANGLE)
  siteDescription   String?
  /// Câmbio usado para converter o custo da entrega, digitado pelo painel.
  ///
  /// A skin é comprada do fornecedor em YUAN, e é isso que fica gravado em
  /// Raffle.deliveryCost. Real e dólar são leituras dele.
  ///
  /// As taxas são digitadas, e não buscadas de uma API, de propósito: número
  /// de câmbio inventado por padrão vira relatório financeiro errado com cara
  /// de certo. Sem taxa cadastrada, a tela mostra só yuan e diz por quê.
  ///
  /// Quantos REAIS vale 1 yuan.
  cnyToBrl          Decimal?  @db.Decimal(12, 6)
  /// Quantos REAIS vale 1 dólar.
  usdToBrl          Decimal?  @db.Decimal(12, 6)

  supportPhone                      String?
  supportEmail                      String?
  homeCampaignsTitle                String?
  homeCampaignsCaption              String?
  showWinnersOnHome                 Boolean   @default(false)
  themeMode                         ThemeMode @default(LIGHT)
  themePreset                       String    @default("orange")
  headerAccent                      Boolean   @default(false)
  cardColor                         String    @default("black")
  termsOfUse                        String?   @db.Text
  privacyPolicy                     String?   @db.Text
  aboutUs                           String?   @db.Text
  // Configurações da aba "Campanha / Compra" (per-tenant).
  // loginMode: "phone" | "cpf", qual identificador usar no login público.
  // numbersNomenclature: como chamar as cotas na UI ("titulos"|"numeros"|"bilhetes"|"numeros_sorte").
  // quantityCardsHeading: texto acima dos quick-picks na página de reserva.
  // minPurchaseAge: idade mínima exigida pra reservar (16/18/21).
  loginMode                         String    @default("phone")
  numbersNomenclature               String    @default("titulos")
  quantityCardsHeading              String?
  minPurchaseAge                    Int       @default(18)
  // Aba "Experiência do Usuário", config global per-tenant que controla
  // comportamento da UI pública (rankings, afiliados, share, etc.).
  affiliateCookieHours              Int       @default(24)
  rankingOrderBy                    String    @default("quantity") // "quantity" | "total"
  rankingCacheMinutes               Int       @default(5)
  requireAddressOnSignup            Boolean   @default(false)
  // Nicho CS2: exigir o link de troca da Steam já no cadastro, em vez de
  // pedir só na hora de entregar o prêmio. Evita correria pós-sorteio.
  requireSteamTradeUrl              Boolean   @default(false)
  // Aviso exibido junto ao campo de link de troca (retenção de 7 dias do
  // Steam Guard, prazo de envio, etc.). Vazio = usa o texto padrão.
  steamDeliveryNotice               String?   @db.Text
  allowPublicAffiliate              Boolean   @default(true)
  shareButtonsGlobal                Boolean   @default(true)
  allowQuantityKeyboardInput        Boolean   @default(true)
  buyerPrivacy                      Boolean   @default(false)
  carouselAutoPlay                  Boolean   @default(true)
  showCardPrices                    Boolean   @default(true)
  showAppButton                     Boolean   @default(true)
  // Aba "Prêmios Instantâneos", config global per-tenant.
  // instantPrizesOrder: ordem em que as modalidades aparecem na página
  // pública. Slugs: "awarded_numbers" | "awarded_box" | "reward_spin"
  // | "scratch_card".
  instantPrizesOrder                String[]  @default(["awarded_numbers", "awarded_box", "reward_spin", "scratch_card"])
  awardedSectionTitle               String    @default("Títulos Premiados")
  showAwardedOnlyWhenDistributed    Boolean   @default(false)
  showAwardedNumbers                Boolean   @default(true)
  showAwardedNumbersBoxes           Boolean   @default(true)
  showAwardedNumbersRoulette        Boolean   @default(true)
  showAwardedNumbersScratchCard     Boolean   @default(true)
  aggregateInstantAwards            Boolean   @default(false)
  disableInstantAwardsRepeatWinners Boolean   @default(false)
  // Aba "Preços / Promoções", toggles globais que afetam a tela de
  // compra do site público.
  showPromotionsPercentage          Boolean   @default(true)
  showCombosPrice                   Boolean   @default(true)
  showFees                          Boolean   @default(true)
  // Economia do rank. `xpPerBrl` é quanto XP cada real gasto credita, 10
  // por padrão. Mexer nele não reescreve o histórico: o extrato guarda o
  // valor já creditado em cada compra.
  xpPerBrl                          Int       @default(10)
  rankEnabled                       Boolean   @default(true)
  rankShowOnHome                    Boolean   @default(true)

  /// SOM DA TRANSMISSÃO DO SORTEIO.
  ///
  /// Desligado aqui, o botão de som some da transmissão e nada toca. Ligado,
  /// cada momento usa o arquivo cadastrado e, sem arquivo, o som sintetizado
  /// que já existia (oscilador, zero download). Guardamos a URL pública do
  /// bucket, do mesmo jeito que logo e favicon.
  somDoSorteioAtivo   Boolean @default(true)
  /// Toca a cada segundo da contagem regressiva. Arquivo curto.
  somContagemUrl      String?
  /// Os dez segundos finais da contagem.
  somContagemFinalUrl String?
  /// A rolagem dos títulos. Com arquivo, ele toca em repetição do começo da
  /// rolagem até o número aparecer, no lugar do clique por título: um arquivo
  /// disparado a cada título viraria ruído sobreposto.
  somRolagemUrl       String?
  /// O número aparecendo na tela. Toca uma vez.
  somRevelacaoUrl     String?

  hosts          TenantHost[]
  taxasDeGateway TaxaDeGateway[]
  raffles        Raffle[]
  members        User[]          @relation("TenantMembers")
  xpEntries      XpEntry[]
  boostEntries   BoostEntry[]
  progress       UserProgress[]
  activityLogs   ActivityLog[]   @relation("TenantActivityLogs")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  skinTemplates SkinTemplate[]
  visitas       VisitaDiaria[]

  /// Id do pixel da Meta. Vazio desliga o rastreamento: sem ele nenhum
  /// script de terceiro entra na página de quem compra.
  metaPixelId String?

  /// Google Analytics 4, no formato "G-XXXXXXXXXX". Vazio desliga.
  googleAnalyticsId String?
  /// Pixel do TikTok Ads. Vazio desliga.
  tiktokPixelId     String?
}

// Domínios apontados pra esse tenant. Um tenant pode ter múltiplos hosts
// (raiz + www + admin). O proxy.ts e getCurrentTenant() resolvem o tenant
// olhando o Host da request nessa tabela.
model TenantHost {
  id       String         @id @default(cuid())
  tenantId String
  host     String         @unique // "sorteios.vip", "www.sorteios.vip", "admin.sorteios.vip"
  kind     TenantHostKind

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================================================================
// RIFAS
// =====================================================================

model Raffle {
  id                   String           @id @default(cuid())
  // Slug é único POR TENANT, Mateus e André podem ter um "iphone-15".
  // O índice composto está em @@unique abaixo. Não pode ser @unique global.
  slug                 String
  title                String
  shortDescription     String?
  description          String?          @db.Text // HTML do Tiptap (sanitizado no servidor)
  descriptionMode      DescriptionMode  @default(COLLAPSED)
  status               RaffleStatus     @default(DRAFT)
  privacy              RafflePrivacy    @default(PUBLIC)
  category             String?
  totalNumbers         Int // ex: 100, 1000, 100000
  pricePerNumber       Decimal          @db.Decimal(10, 2)
  isFree               Boolean          @default(false) // campanha gratuita
  // Texto exibido no card de preço quando isFree=true. Vazio = usa default
  // ("SORTEIO GRATUITO"). Admin pode personalizar pra "PARTICIPAÇÃO LIVRE",
  // "ENTRADA GRÁTIS", etc.
  freeLabel            String?
  hasFee               Boolean          @default(false) // adicionar taxa por reserva
  feeAmount            Decimal?         @db.Decimal(10, 2)
  /// Números aleatórios por padrão. O formulário do painel já vem nesse
  /// valor, e o padrão do banco acompanha para quem criar campanha por outro
  /// caminho não cair num modelo diferente do que a tela mostra.
  reservationModel     ReservationModel @default(RANDOM_NUMBERS)
  modality             RaffleModality   @default(OWN_DRAW)
  drawDate             DateTime?
  salesStart           DateTime?
  autoCloseOnDraw      Boolean          @default(true)
  showDrawDate         Boolean          @default(true)
  allowReceiptDownload Boolean          @default(true)
  showOnHome           Boolean          @default(false) // destacar na home

  /// A campanha principal do site: a que vira o card grande no topo da home e
  /// da lista de campanhas. Só uma por tenant, garantido por índice parcial na
  /// migration: duas principais fariam a vitrine escolher uma pela ordem de
  /// criação, que é o mesmo que não ter escolhido.
  principal Boolean @default(false)

  /// Posição na vitrine, menor primeiro. Empate cai para a mais recente, que
  /// é o comportamento antigo. Existe porque a ordem era só a data de
  /// criação: para subir uma campanha antiga não havia nada a fazer além de
  /// recriá-la.
  ordem                     Int     @default(0)
  showProgressBar           Boolean @default(true)
  showParticipantName       Boolean @default(false) // exibe nome de quem comprou
  showDailyRanking          Boolean @default(false)
  showOverallRanking        Boolean @default(false)
  showShareButtons          Boolean @default(true)
  // Quick-picks da seleção de quantidade na página pública. Até 6 valores
  // (ex: [5, 10, 100, 500, 1000, 5000]); array vazio = sem quick-picks.
  // bestseller: índice 0-5 que ganha destaque "MAIS POPULAR" (-1 = nenhum).
  selectionCards            Int[]   @default([])
  selectionCardsBestseller  Int     @default(-1)
  statusText                String?
  // JSON: { name, phone, cpf, email, socialName, birthDate } -> bool.
  // Tudo OFF por padrão: identidade vem da conta logada. Admin liga
  // qualquer um pra forçar o campo a aparecer na "Dados adicionais" da
  // reserva, útil pra reconfirmar telefone/email em rifas específicas.
  requiredFields            Json    @default("{\"name\":false,\"phone\":false,\"cpf\":false,\"email\":false,\"socialName\":false,\"birthDate\":false}")
  minPurchase               Int     @default(1)
  maxPurchase               Int?
  initialQuantity           Int? // quantidade pré-selecionada no input
  maxPerBuyer               Int? // cap cumulativo por CPF (todas as reservas)
  reservationTimeoutMinutes Int     @default(5)

  // Quando setado, sobrescreve o tenant.paymentProvider só nesse sorteio
  // (credenciais continuam vindo do tenant). NULL = herda o padrão do
  // tenant. Configurado em Admin → Editar sorteio → aba Pagamento.
  paymentProvider PaymentProvider?

  // Config dos Títulos Premiados (prêmio instantâneo): ver AwardedTicket
  // pra lista de números. Aqui ficam os toggles e textos de exibição.
  awardedTicketsEnabled    Boolean @default(false)
  awardedTicketsShowList   Boolean @default(false) // mostra lista pro público?
  awardedTicketsViewMode   String  @default("list") // "list" | "modal"
  awardedTicketsWinnerText String? @db.Text
  awardedTicketsLoserShow  Boolean @default(false)
  awardedTicketsLoserTitle String?
  awardedTicketsLoserText  String? @db.Text

  // Config das Promoções (combos de cotas com desconto). As entradas
  // ficam em Promotion; aqui só os toggles e flags de exibição.
  promotionsEnabled       Boolean   @default(false)
  // "Promoção em Dobro": cliente recebe 2x os números pelo mesmo valor.
  promotionsDoubleEnabled Boolean   @default(false)
  /// Janela da promocao. As duas nulas quer dizer "enquanto estiver ligada",
  /// sem prazo. So a de fim preenchida e o caso comum: comeca agora e tem
  /// hora para acabar, que e o que da urgencia.
  promotionsDoubleFrom    DateTime?
  promotionsDoubleUntil   DateTime?
  // Quando true, várias promoções podem somar/acumular num mesmo pedido
  // (semântica controlada na lógica de checkout, hoje só persistido).
  promotionsAccumulative  Boolean   @default(false)

  // Config dos Prêmios (lista em Prize). Toggle de visibilidade pro
  // público + bloco de E-book entregue após pagamento (estilo SkinsLendarias).
  prizesShow      Boolean @default(true)
  /// Ficha técnica da skin na página pública (raridade, desgaste, float,
  /// coleção, valor). Desligada por padrão: ocupa meia tela no mobile e só
  /// se paga nas skins caras, onde o float justifica o preço.
  showSkinSpecs   Boolean @default(false)
  ebookEnabled    Boolean @default(false)
  ebookTitle      String?
  ebookText       String? @db.Text
  ebookUrl        String?
  ebookButtonText String?

  // Caixas Surpresas: cliente ganha N caixas ao bater certo número de cotas
  // pagas. A distribuição em si (sortear prêmios do pool, criar SurpriseBox
  // por reserva PAID) será implementada em iteração futura, por ora só os
  // toggles + tiers de combo. "Acumulativos" = somar todos os tiers atingidos
  // (ex: 100 cotas → 1+3+10+15 caixas); off = só o maior tier ganha.
  /// Imagem pequena que aparece ao lado de "Número sorteado", na transmissão.
  ///
  /// Ornamento por campanha: o troféu do Major numa, outro numa especial,
  /// nenhum na campanha comum. Guarda a URL pública do bucket, como o resto
  /// das imagens do sorteio; vazio simplesmente não desenha nada.
  trofeuUrl String?

  /// A campanha aceita Cupom de Entrada do programa de afiliados.
  ///
  /// Ligada, qualquer cupom vale aqui, seja qual for o preço da cota: o cupom
  /// abate até o valor de face e a pessoa paga a diferença. Não existe teto de
  /// preço de cota.
  aceitaCupomDeAfiliado Boolean @default(true)

  surpriseBoxEnabled            Boolean                 @default(false)
  surpriseBoxCombosAccumulative Boolean                 @default(false)
  // Toggles secundários do modal Caixas Surpresas (só fazem sentido com
  // surpriseBoxEnabled=true): "Abrir todas" = comprador pode abrir as
  // caixas todas de uma vez (sem animação individual); "Exibir Ganhadores"
  // = mostra na pagina pública uma lista dos ganhadores das caixas.
  surpriseBoxAbrirTodas         Boolean                 @default(false)
  surpriseBoxExibirGanhadores   Boolean                 @default(false)
  // Ordem de exibição dos ganhadores na lista pública: aleatório,
  // crescente (mais antigos primeiro) ou decrescente (mais recentes).
  surpriseBoxDisplayOrder       SurpriseBoxDisplayOrder @default(RANDOM)

  // Ganhador do sorteio principal. Setado quando o admin declara o
  // resultado pós-sorteio (Loteria Federal ou sorteio próprio). A rifa
  // vira FINISHED nesse momento. winnerNote é livre, admin pode colar o
  // extrato da Loteria, hash do bloco usado como semente, link do vídeo
  // do sorteio, etc. Registro de auditoria pra transparência.
  winnerTicketNumber Int?
  winnerDrawnAt      DateTime?
  winnerNote         String?   @db.Text

  /// Controle de entrega da skin principal, para a fila de /admin/entregas.
  ///
  /// A tela já listava ganhador, prêmio e link de troca, mas nada dizia o que
  /// já tinha saído: campanha sorteada há um mês ficava do lado da de ontem,
  /// e quem operava precisava lembrar de cor. Marcar aqui é o que separa a
  /// fila do histórico.
  ///
  /// Em que pé está a entrega. Ver o enum para o significado de cada estado.
  deliveryStatus DeliveryStatus @default(AGUARDANDO)

  /// QUANDO ESTA ENTREGA FOI TIRADA DA FILA.
  ///
  /// Some da tela de Entregas, e não do banco: sorteio de teste, campanha
  /// cancelada e entrega resolvida por fora enchem a fila de linha que
  /// ninguém vai tocar, e uma fila cheia de ruído esconde o que falta fazer.
  /// Nulo é entrega na fila, que é o estado de toda campanha sorteada.
  ///
  /// Arquivar não apaga nem mexe no sorteio: o ganhador, o número e o
  /// comprovante continuam de pé, e o filtro "Removidas" traz a linha de
  /// volta. Apagar a campanha para limpar a fila levaria junto o resultado
  /// público de um sorteio que aconteceu.
  entregaArquivadaEm DateTime?

  /// Quando a skin de fato saiu. Preenchido ao entrar em ENVIADO e limpo ao
  /// sair dele: é a data da entrega, e não a data da última mexida no status.
  deliveredAt   DateTime?
  /// Quem marcou. Sem relação declarada de propósito: é registro de auditoria,
  /// e apagar a conta de um operador não pode apagar o histórico de entrega.
  deliveredById String?
  /// Observação da entrega: número da oferta na Steam, combinação feita, o que
  /// for. Livre porque cada entrega tem a sua história.
  deliveryNote  String?   @db.Text

  /// Quanto custou comprar a skin do fornecedor para entregar ao ganhador.
  ///
  /// É o custo REAL da premiação, e não tem como sair de nenhum outro lugar:
  /// o preço da cota é receita, o valor de mercado da skin é estimativa, e o
  /// que saiu do caixa é isto aqui, digitado por quem comprou.
  ///
  /// Decimal, e não Float: dinheiro em ponto flutuante acumula erro de
  /// centavo, e a soma da coluna é o número que interessa.
  deliveryCost Decimal? @db.Decimal(10, 2)

  /// O PTAX de venda do dia em que ESTA entrega saiu: reais por yuan.
  ///
  /// Sem isto, o relatório converte todo o histórico pela taxa global do
  /// painel, e o gasto de julho é reconvertido pelo câmbio de hoje toda vez
  /// que alguém atualiza a taxa. Com a taxa gravada na linha, cada compra
  /// carrega o câmbio do dia dela e o fechamento para de oscilar.
  ///
  /// Seis casas porque taxa não é dinheiro: 0,760500 arredondado para 0,76
  /// erra R$ 0,42 numa compra de ¥ 850.
  deliveryFxRate Decimal? @db.Decimal(12, 6)

  /// O dia do boletim que gerou deliveryFxRate.
  ///
  /// Pode ser anterior ao envio: fim de semana e feriado não têm boletim, e o
  /// que vale é o último dia útil. Guardar qual foi é o que torna a conversão
  /// conferível depois, em vez de um número sem procedência.
  deliveryFxDate DateTime?

  /// De onde a taxa veio: "PTAX" ou "AWESOMEAPI".
  ///
  /// Duas fontes podem responder pela mesma moeda, e sem isto a taxa vira um
  /// número sem procedência: não daria para reconciliar o relatório com o
  /// boletim depois, nem para saber quais linhas usaram a oficial.
  ///
  /// Texto e não enum: é rótulo de origem, e acrescentar uma fonte não deveria
  /// exigir migration de tipo.
  deliveryFxSource String?

  /// Campanha exclusiva: nível mínimo (1–21) para conseguir reservar.
  /// NULL = aberta a todos. Quem já está em patente de prestígio passa em
  /// qualquer exigência. É o que dá consequência ao rank.
  minLevel Int?

  createdById String
  createdBy   User   @relation("CreatedRaffles", fields: [createdById], references: [id])

  // Tenant ao qual a rifa pertence. O slug é único dentro do tenant,
  // domínios diferentes podem ter sorteios com o mesmo slug.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  images            RaffleImage[]
  prizes            Prize[]
  tickets           Ticket[]
  awardedTickets    AwardedTicket[]
  reservations      Reservation[]
  promotions        Promotion[]
  discountLinks     DiscountLink[]
  utmLinks          UtmLink[]
  surpriseBoxCombos SurpriseBoxCombo[]
  surpriseBoxPrizes SurpriseBoxPrize[]
  surpriseBoxes     SurpriseBox[]

  /// Raspadinha Premiada. Mesma ideia da Caixa Surpresa, experiencia outra.
  raspadinhaEnabled     Boolean            @default(false)
  /// Deixa raspar todas de uma vez, em vez de uma a uma.
  raspadinhaRasparTodas Boolean            @default(false)
  raspadinhaCombos      RaspadinhaCombo[]
  raspadinhaPremios     RaspadinhaPremio[]
  raspadinhas           Raspadinha[]
  entradasGratis        EntradaGratis[]

  /// O sorteio ao vivo desta campanha. No máximo um, garantido pelo @unique
  /// do lado do Draw: dois sorteios oficiais para a mesma campanha seriam
  /// dois ganhadores para o mesmo prêmio.
  draw     Draw?
  drawSeed DrawSeed?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  visitasDeCampanha VisitaDeCampanha[]

  @@unique([tenantId, slug])
  @@index([status, privacy])
  @@index([createdById])
  @@index([tenantId])
}

model RaffleImage {
  id       String  @id @default(cuid())
  raffleId String
  url      String
  order    Int     @default(0)
  isCover  Boolean @default(false)

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([raffleId])
}

/// Raridade da skin no CS2. As cores oficiais de cada faixa ficam em
/// `src/lib/cs2.ts` e colorem a borda do card na interface.
/// Skin cadastrada uma vez e reaproveitada em vários sorteios.
///
/// Sem isto, abrir campanha da mesma faca duas vezes significa redigitar
/// raridade, desgaste, float, coleção e valor, e reenviar a mesma imagem. O
/// catálogo guarda essa ficha junto da foto: criar sorteio vira escolher da
/// lista, e os dados chegam iguais toda vez.
/// Tentativas de login falhas, para frear varredura de contas.
///
/// O login do site é por nome + CPF, sem senha. Sem freio, quem tem uma lista
/// de CPFs vazados pode varrer o site testando combinações até acertar, e
/// nada no caminho reclamaria.
///
/// Guardar em banco, e não em memória, é o que faz funcionar aqui: cada
/// requisição pode cair numa instância diferente do servidor, e um contador
/// em memória seria zerado a cada troca.
model LoginAttempt {
  /// O que está sendo freado: "ip:203.0.113.4" ou "cpf:00000000000".
  chave String @id

  /// Falhas seguidas dentro da janela atual.
  falhas Int @default(0)

  /// Começo da janela. Passada a janela, a contagem recomeça.
  desde DateTime @default(now())

  /// Preenchido e no futuro: o login é recusado antes de consultar
  /// qualquer conta.
  bloqueadoAte DateTime?

  atualizadoEm DateTime @updatedAt

  @@index([bloqueadoAte])
}

model SkinTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nome completo, como aparece no jogo: "AWP | Dragon Lore".
  name String

  /// Foto da skin. Opcional porque a ficha já vale sozinha, mas é ela que
  /// dispensa reenviar a mesma imagem a cada campanha.
  imageUrl String?

  /// Ficha técnica, espelhando os campos de Prize. Todos opcionais: dá para
  /// cadastrar só o nome e completar depois.
  skinRarity     SkinRarity?
  skinWear       SkinWear?
  /// Em quais desgastes esta skin existe. Vem da fonte de itens do CS2, e
  /// não é decorativo: 504 das 2126 skins não existem nos cinco. A M4A4 Howl
  /// para em Well-Worn porque o float dela não passa de 0,4, e oferecer
  /// Battle-Scarred na criação do sorteio prometeria um item inexistente.
  /// Lista vazia quer dizer "não tem desgaste": agente é personagem e faca
  /// sem pintura não tem acabamento. Skin cadastrada à mão nasce com os
  /// cinco, então não existe estado de "não sei" para representar aqui.
  skinWears      SkinWear[]
  skinFloat      Float?
  skinStatTrak   Boolean     @default(false)
  skinSouvenir   Boolean     @default(false)
  skinValueBrl   Decimal?    @db.Decimal(10, 2)
  skinCollection String?
  skinInspectUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A arte de campanha desta skin, por desgaste.
  artes SkinArt[]

  /// O preço da Steam, guardado por desgaste.
  precos SkinPreco[]

  /// Nome único por tenant: cadastrar a mesma skin duas vezes só cria dúvida
  /// na hora de escolher.
  @@unique([tenantId, name])
  @@index([tenantId])
}

/// O preço de uma skin no Mercado da Comunidade Steam, em real.
///
/// Uma linha por desgaste, e nao uma por skin: a mesma AWP custa milhares a
/// mais Factory New do que Battle-Scarred, e um valor unico por skin daria um
/// preco por numero errado em quatro dos cinco casos.
///
/// Existe por causa do limite da Steam. A rota nao e oficial e passa a
/// responder 429 depois de algumas dezenas de chamadas por minuto, entao o
/// preco e buscado uma vez e reaproveitado. `buscadoEm` e o que diz se o valor
/// ainda serve ou se vale perguntar de novo.
model SkinPreco {
  id             String       @id @default(cuid())
  skinTemplateId String
  skin           SkinTemplate @relation(fields: [skinTemplateId], references: [id], onDelete: Cascade)

  /// Nulo para item sem desgaste, como agente.
  wear SkinWear?

  /// Em reais, como a Steam devolve com currency=7. Sem conversao nossa.
  brl Decimal @db.Decimal(10, 2)

  /// O nome exato que a Steam reconheceu. Guardado porque para faca sem
  /// pintura ele difere do nome do catalogo, e sem isso a diferenca viraria
  /// mistério na hora de conferir um preco estranho.
  nomeConsultado String

  /// Quantas unidades venderam nas ultimas 24h, quando a Steam informa.
  /// Volume baixo quer dizer preco pouco confiavel.
  volume Int?

  buscadoEm DateTime @default(now())

  /// Um preco por desgaste. O do desgaste nulo tem indice parcial proprio na
  /// migration: em Postgres, NULL nao e igual a NULL.
  @@unique([skinTemplateId, wear])
  @@index([skinTemplateId])
}

/// Quantas vezes cada link de campanha de um sorteio foi aberto.
///
/// Separado de VisitaDiaria porque a pergunta e outra: aquela mede o site
/// inteiro ao longo do tempo, esta mede qual canal esta trazendo gente para
/// UM sorteio. Sem dimensao de dia de proposito: o painel mostra o total por
/// canal, e guardar por dia multiplicaria as linhas por nada.
model VisitaDeCampanha {
  id       String @id @default(cuid())
  raffleId String
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  /// O valor de utm_content do link. Minusculo e sem espaco, como sai do
  /// montador de links.
  canal String

  visitas Int @default(0)

  @@unique([raffleId, canal])
  @@index([raffleId])
}

/// Quantas visitas o site recebeu, por dia.
///
/// Guarda o contador do dia, e nao uma linha por acesso: o painel so precisa
/// de "hoje", "ontem" e "total", e uma tabela com uma linha por pageview
/// chegaria a milhoes de linhas para responder tres numeros.
///
/// Duas contagens, porque sao perguntas diferentes. `visitas` conta cada
/// pagina aberta, que e o que mede movimento e serve para comparar com o
/// gasto de anuncio. `visitantes` conta pessoa distinta no dia, que e o que
/// nao infla quando alguem fica recarregando a mesma pagina.
model VisitaDiaria {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// O dia em Brasilia, a meia-noite. O fuso e o do negocio, nao o do
  /// servidor: "visitas de hoje" tem de virar quando vira o dia aqui.
  dia DateTime @db.Date

  visitas    Int @default(0)
  visitantes Int @default(0)

  @@unique([tenantId, dia])
  @@index([tenantId, dia])
}

/// A arte de campanha de uma skin.
///
/// É diferente da foto da skin. A foto é o render do jogo, que veio da fonte
/// de itens e serve para mostrar o item em "Ver as skins premiadas". A arte é
/// feita à mão, tem logo, fundo e o nome escrito, e é ela que vira a capa do
/// sorteio.
///
/// Fica presa ao desgaste porque a arte traz o desgaste escrito nela: a de
/// "AK-47 | Redline (Field Tested)" não serve para a Minimal Wear. Com `wear`
/// nulo, a mesma arte vale para qualquer desgaste, que é a saída para quem
/// não quer desenhar cinco.
model SkinArt {
  id             String       @id @default(cuid())
  skinTemplateId String
  skin           SkinTemplate @relation(fields: [skinTemplateId], references: [id], onDelete: Cascade)

  /// Nulo vale para qualquer desgaste, e só entra quando não há arte
  /// específica para o desgaste escolhido.
  wear SkinWear?

  url String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Uma arte por desgaste. A do desgaste nulo tem índice parcial próprio na
  /// migration: em Postgres, NULL não é igual a NULL, e sem ele daria para
  /// cadastrar duas artes genéricas para a mesma skin.
  @@unique([skinTemplateId, wear])
  @@index([skinTemplateId])
}

enum SkinRarity {
  CONSUMER
  INDUSTRIAL
  MIL_SPEC
  RESTRICTED
  CLASSIFIED
  COVERT
  CONTRABAND
  EXTRAORDINARY
}

/// Desgaste (exterior) da skin. O float exato vai em Prize.skinFloat.
enum SkinWear {
  FACTORY_NEW
  MINIMAL_WEAR
  FIELD_TESTED
  WELL_WORN
  BATTLE_SCARRED
}

/// Motivo de um lançamento de XP.
enum XpReason {
  /// Compra paga, a única entrada que faz o rank subir.
  PURCHASE
  /// Estorno de uma compra: lançamento negativo.
  REFUND
  /// Ajuste manual pelo painel administrativo.
  ADMIN_ADJUST
  /// Bônus de campanha, evento ou compensação.
  BONUS
}

/// Extrato de XP. É a fonte da verdade: `UserProgress.xp` é apenas o total
/// desnormalizado, recalculado a partir daqui. Ter o extrato permite explicar
/// ao usuário de onde veio cada ponto e reverter um estorno sem chute.
model XpEntry {
  id            String   @id @default(cuid())
  userId        String
  tenantId      String
  amount        Int
  reason        XpReason
  reservationId String?
  description   String?

  /// A conta que produziu `amount`, congelada no momento do lançamento.
  ///
  /// Guardar a decomposição, e não só o total, é o que permite explicar o
  /// extrato ("XP base 800, boost 1,2x, +160") sem recalcular: regra que
  /// mudar amanhã não pode reescrever o que foi creditado ontem.
  /// Nulo nos lançamentos antigos, anteriores ao multiplicador.
  baseXp     Int?
  multiplier Decimal? @db.Decimal(4, 2)
  bonusXp    Int?
  /// Detalhe complementar: faixa da compra, bônus de sorte, evento.
  metadata   Json?

  createdAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  /// Idempotência: uma reentrega de webhook não credita duas vezes.
  /// reservationId NULL fica fora do índice parcial, então ajustes manuais
  /// e bônus podem se repetir.
  @@unique([userId, reason, reservationId])
  @@index([userId, tenantId, createdAt(sort: Desc)])
  @@index([tenantId])
}

/// Progresso do participante em um tenant. O rank é por operador: comprar no
/// site de outro não pode levantar o nível aqui.
model UserProgress {
  id       String @id @default(cuid())
  userId   String
  tenantId String
  xp       Int    @default(0)

  /// Gasto acumulado em compras pagas, em reais.
  ///
  /// Desnormalizado porque o GOAT depende dele e o rank é lido em toda página
  /// pública; agregar as reservas a cada leitura seria uma soma por render.
  /// É dado FINANCEIRO: fica no servidor e não vai para a interface.
  totalSpent Decimal @default(0) @db.Decimal(12, 2)

  /// Pontos de boost, de 0 a 100. O multiplicador NÃO é gravado: é derivado
  /// dos pontos, senão os dois desandam e um passa a mentir sobre o outro.
  boostPoints Int @default(0)

  /// Sequência de dias diferentes com participação.
  currentStreak Int @default(0)
  longestStreak Int @default(0)

  /// Último dia oficial com participação, como "AAAA-MM-DD" no fuso do
  /// projeto. Texto, e não data: o que importa é o DIA no fuso oficial, e
  /// guardar timestamp obrigaria a reconverter a cada leitura.
  lastActiveDate      String?
  lastParticipationAt DateTime?

  /// Perdoa uma ausência sem quebrar a sequência.
  streakProtectionAvailable Boolean   @default(true)
  streakProtectionUsedAt    DateTime?
  /// Dias ativos desde que a proteção foi gasta, para ela voltar.
  diasAtivosAposProtecao    Int       @default(0)

  /// Última aplicação do decaimento, para ele não rodar duas vezes no mesmo
  /// período só porque a pessoa abriu a página de novo.
  lastDecayAppliedAt DateTime?
  lastDecayDay       String?

  /// Última premiação registrada, base do Boost de Sorte.
  lastWinAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, xp(sort: Desc)])
}

/// Motivo de uma alteração de pontos de boost.
enum BoostReason {
  ACTIVITY
  STREAK
  MISSION
  DECAY
  TEMPORARY_BOOST
  ADMIN_ADJUSTMENT
}

/// Histórico das alterações de boost. Mesma ideia do extrato de XP: nenhum
/// ponto entra ou sai sem deixar rastro de por quê.
model BoostEntry {
  id       String      @id @default(cuid())
  userId   String
  tenantId String
  type     BoostReason
  points   Int
  reason   String

  /// Idempotência. Um marco de sequência por ciclo, um decaimento por dia,
  /// uma missão por ciclo: a chave carrega esses limites.
  idempotencyKey String

  /// Boost temporário: depois disto ele deixa de contar.
  expiresAt DateTime?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([idempotencyKey])
  @@index([userId, tenantId, createdAt(sort: Desc)])
}

model Prize {
  id          String  @id @default(cuid())
  raffleId    String
  position    Int // 1 = 1º prêmio, 2 = 2º prêmio, etc.
  description String
  imageUrl    String?

  // Metadados da skin de CS2 premiada. Todos opcionais: um prêmio pode ser
  // um item que não é skin (saldo, periférico) e aí é só `description`.
  // Quando skinRarity está preenchida, o card do prêmio ganha a cor oficial
  // da raridade e a página pública exibe a ficha técnica completa.
  skinName       String?
  skinRarity     SkinRarity?
  skinWear       SkinWear?
  /// Float exato do item (0.0000 a 1.0000), como aparece no inspecionar.
  skinFloat      Float?
  skinStatTrak   Boolean     @default(false)
  skinSouvenir   Boolean     @default(false)
  /// Valor de mercado em reais, exibido como "avaliada em".
  skinValueBrl   Decimal?    @db.Decimal(10, 2)
  skinCollection String?
  /// Link `steam://rungame/730/...` para inspecionar o item no jogo.
  skinInspectUrl String?

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, position])
  @@index([raffleId])
}

// LAZY MODEL, só existe quando reservado/pago. Ver topo do arquivo.
model Ticket {
  id            String       @id @default(cuid())
  raffleId      String
  number        Int
  status        TicketStatus
  reservationId String?
  paidAt        DateTime?

  raffle      Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([raffleId, number])
  @@index([raffleId, status])
  @@index([reservationId])
}

model AwardedTicket {
  id               String  @id @default(cuid())
  raffleId         String
  number           Int
  prizeDescription String
  isInstantPrize   Boolean @default(false)

  /// Raridade da skin premiada, quando o prêmio foi escolhido do catálogo.
  /// Nula quando é texto livre, que continua válido: nem todo título premiado
  /// é skin ("R$ 500 no Pix"). Só serve para a cor do nome na lista pública,
  /// que é a leitura que o jogador já tem dentro do jogo.
  skinRarity SkinRarity?

  /// A FOTO da skin, copiada do catálogo pelo mesmo casamento de nome que
  /// resolve a raridade. Guardada aqui, e não buscada na hora de desenhar a
  /// página: a lista é pública e de tráfego alto, e cruzar 865 skins do
  /// catálogo a cada visita para achar sete fotos é conta que não se paga.
  ///
  /// Nula é o caso normal de prêmio que não é skin, e a lista desenha o
  /// selo com a sigla da arma no lugar, sem espaço vazio.
  skinImageUrl String?

  /// CONDICOES PARA O NUMERO PAGAR.
  ///
  /// Aqui NAO existe ponto de saida em porcentagem, e a diferenca e do
  /// modelo, nao um esquecimento: o titulo premiado e amarrado a um NUMERO.
  /// Quem comprar o 120 leva, e nao ha bolo para sortear nem quando agendar.
  /// O numero ja e o agendamento.
  ///
  /// O que faz sentido e o outro eixo: para QUAL COMPRA ele paga. Serve ao
  /// disparo com hora marcada, que e o caso real: numero premiado que so paga
  /// depois das 14h espera a compra que veio do disparo.
  ///
  /// Todos nulos ou vazio e o comportamento de sempre: comprou, ganhou.
  saidaTitulosDe  Int?
  saidaTitulosAte Int?
  saidaDataDe     DateTime?
  saidaDataAte    DateTime?
  saidaDdds       String[]

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, number])
  @@index([raffleId])
}

enum PromotionType {
  QTY // "Compre exatamente N cotas por R$ X" (combo fixo)
  MORE_THAN // "A partir de N cotas, pague R$ X" (tier por volume)
}

model Promotion {
  id       String        @id @default(cuid())
  raffleId String
  quantity Int // ex: 10 títulos (QTY) ou limite mínimo (MORE_THAN)
  price    Decimal       @db.Decimal(10, 2) // ex: R$ 50,00
  label    String?
  type     PromotionType @default(QTY)

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([raffleId])
}

// Tier de Caixas Surpresas: comprou ≥ threshold cotas → ganha boxCount caixas.
// Configurado por rifa no modal "Distribuição das Caixas".
// - visible: mostra esse combo na página pública (área de Caixas Surpresas)
// - highlighted: destaca visualmente (badge/cor diferente) na lista pública
model SurpriseBoxCombo {
  id          String  @id @default(cuid())
  raffleId    String
  threshold   Int // "A partir de X Títulos"
  boxCount    Int // "Ganha N CAIXAS!"
  visible     Boolean @default(true)
  highlighted Boolean @default(false)

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, threshold])
  @@index([raffleId])
}

enum SurpriseBoxDisplayOrder {
  RANDOM // ordem aleatória na listagem pública
  ASC // mais antigos primeiro
  DESC // mais recentes primeiro
}

enum SurpriseBoxPrizeMode {
  RANDOM // sorteio uniforme entre os itens disponíveis no pool
  PERCENT // odds-based, admin define a chance (%) daquele item sair
}

/// Em que pe esta a decisao do premio de uma unidade (caixa ou raspadinha).
///
/// Existe porque `prizeId = null` sozinho nao distingue tres coisas diferentes:
/// "ainda nao decidi", "decidi e nao deu premio" e "nasci antes de existir
/// decisao na compra". Sem separar, uma falha na alocacao fazia a unidade cair
/// em silencio no caminho antigo, sorteando na abertura.
enum EstadoDaAlocacao {
  /// Criada antes do sorteio passar para a compra. Resolve na abertura, como
  /// sempre fez. Nenhuma unidade nova entra neste estado.
  LEGADO
  /// Criada e esperando a alocacao. Se ficar parada aqui, houve falha: a
  /// alocacao pode ser repetida sem risco, e nunca resolve na abertura.
  PENDENTE
  /// Destino definido e gravado. A partir daqui e imutavel.
  ALOCADA
}

enum SurpriseBoxStatus {
  UNOPENED // caixa criada pós-pagamento, aguardando o comprador abrir
  OPENED_PRIZE // aberta e ganhou um prêmio (prizeId preenchido)
  OPENED_EMPTY // aberta mas saiu vazia ("não foi dessa vez")
}

// Item/prêmio cadastrado no pool das Caixas Surpresas de uma rifa. Cada
// linha = 1 unidade (estoque implícito = 1). O form admin permite criar
// até 100 cópias de uma vez com o mesmo título/prêmio. Quando o item é
// sorteado pra uma caixa aberta, claimedAt fica preenchido e a relação
// inversa `claimedByBox` aponta pra SurpriseBox.
//
// - locked: admin "esconde" sem deletar, não entra no pool de sorteio.
// - mode: RANDOM (uniforme) | PERCENT (chance individual em odds).
// - odds: usado só em PERCENT. 0-100. Soma dos PERCENT pode ser < 100,
//   resto vira chance de caixa vazia.
/// Como um premio instantaneo decide a hora de sair.
enum TipoDeSaida {
  /// Por andamento da venda: sai ao alcancar um titulo. E o padrao, e o
  /// agendamento e feito sozinho no cadastro.
  PROGRESSO
  /// Por condicao da compra: tamanho, data e DDD.
  PERSONALIZADO
}

model SurpriseBoxPrize {
  id       String @id @default(cuid())
  raffleId String
  title    String // agrupador/categoria do prêmio (ex: "Skins Lendárias")
  prize    String // descrição do que sai pro ganhador

  /// Mesma coisa do AwardedTicket: raridade quando veio do catálogo, nula
  /// quando é texto livre.
  skinRarity SkinRarity?
  mode       SurpriseBoxPrizeMode @default(RANDOM)
  odds       Decimal?             @db.Decimal(5, 2) // só em PERCENT
  locked     Boolean              @default(false)

  /// QUANDO ESTE PREMIO SAI.
  ///
  /// Antes o premio so era escolhido na hora da abertura, por chance ou
  /// uniforme: nem quem cadastrou sabia quando ele apareceria, e um item
  /// grande podia sair na primeira caixa ou nunca. Agora ele nasce com um
  /// ponto de saida, e esse ponto e promessa: vai para a PRIMEIRA caixa
  /// aberta a partir dali.
  tipoDeSaida TipoDeSaida @default(PROGRESSO)

  /// O ponto de saida, em TITULOS VENDIDOS. So em PROGRESSO.
  ///
  /// Em titulos e nao em porcentagem de proposito: porcentagem e leitura, nao
  /// dado. Guardada como numero, ela mudaria de significado no dia em que a
  /// campanha alterasse o total de numeros, sem ninguem ter tocado no premio.
  saidaEmTitulos Int?

  /// Condicoes da COMPRA que pode levar. So em PERSONALIZADO, e cada campo em
  /// branco simplesmente nao filtra.
  saidaTitulosDe  Int?
  saidaTitulosAte Int?
  saidaDataDe     DateTime?
  saidaDataAte    DateTime?
  /// DDDs que podem levar. Vazio = qualquer um.
  saidaDdds       String[]
  claimedAt       DateTime? // setado atomicamente quando uma caixa abre e leva esse item

  raffle       Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  claimedByBox SurpriseBox?

  createdAt DateTime @default(now())

  @@index([raffleId])
  @@index([raffleId, locked, claimedAt])
}

// Caixa-instância gerada pós-pagamento. Cada reserva PAID que atingiu
// algum combo recebe N SurpriseBox em status UNOPENED. O comprador abre
// uma a uma (ou todas se surpriseBoxAbrirTodas estiver on), e cada
// abertura tenta atomicamente sortear um item do pool. Se sair item =
// status OPENED_PRIZE + prizeId. Se pool vazio/zerou = OPENED_EMPTY.
model SurpriseBox {
  id            String            @id @default(cuid())
  raffleId      String
  reservationId String
  status        SurpriseBoxStatus @default(UNOPENED)
  /// O premio desta caixa, decidido na CONFIRMACAO DO PAGAMENTO e nao mais na
  /// abertura. Nulo quando o sorteio nao deu premio nenhum.
  ///
  /// Mudou de momento porque o painel precisava saber quem ganhou sem esperar
  /// a pessoa clicar: uma caixa fechada nao dizia nada, e um premio que ja
  /// tinha dono ficava invisivel para quem precisa entregar. Abrir passou a
  /// ser so revelar o que ja estava aqui.
  prizeId       String?           @unique
  openedAt      DateTime?

  /// O estado da decisao desta caixa. Ver EstadoDaAlocacao.
  alocacao EstadoDaAlocacao @default(PENDENTE)

  /// Quantos titulos a campanha tinha vendido ANTES da compra que gerou esta
  /// caixa. Com `vendidosNaSaida` forma o intervalo que a compra atravessou, e
  /// e o que permite conferir depois se um premio saiu no ponto certo.
  vendidosAntes Int?

  /// Quantos titulos a campanha tinha vendido quando esta caixa foi sorteada.
  ///
  /// Guardado no momento do sorteio, e nao recalculado depois: a venda anda,
  /// e "saiu em 24%" precisa continuar dizendo 24% no mes seguinte. E o par do
  /// ponto agendado do premio, que diz onde ele DEVIA sair; sem este, nao ha
  /// como conferir se a promessa foi cumprida.
  vendidosNaSaida Int?

  /// Quando o sorteio desta caixa foi feito.
  ///
  /// Separa "ainda nao sorteei" de "sorteei e nao deu premio", que sem isto
  /// sao a mesma coisa: prizeId nulo. As caixas criadas antes desta mudanca
  /// tem a coluna nula e continuam sorteando na abertura, como sempre
  /// fizeram, senao virariam todas vazias de uma vez.
  premioSorteadoEm DateTime?

  raffle      Raffle            @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  reservation Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  prize       SurpriseBoxPrize? @relation(fields: [prizeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reservationId])
  @@index([reservationId, alocacao])
  @@index([raffleId, status])
}

// =====================================================================
// RASPADINHA PREMIADA
// =====================================================================
//
// Espelha a Caixa Surpresa de proposito: as duas sao "o comprador ganhou N
// tentativas e cada uma pode ter premio". O que muda e a experiencia, nao a
// regra. Copiar a forma faz o sorteio, a atomicidade e a checagem de dono
// se comportarem igual nos dois, em vez de duas invencoes com bugs
// diferentes.

enum RaspadinhaStatus {
  DISPONIVEL // criada pos-pagamento, esperando o comprador raspar
  PREMIADA // raspada e com premio (premioId preenchido)
  SEM_PREMIO // raspada e sem premio
}

enum TipoDePremioDaRaspadinha {
  PIX // dinheiro
  SKIN // item do jogo
}

/// Um premio possivel das raspadinhas de um sorteio.
///
/// `claimedAt` e a trava de unicidade: o mesmo premio nunca sai duas vezes,
/// porque quem revela primeiro o marca dentro da mesma transacao.
model RaspadinhaPremio {
  id       String @id @default(cuid())
  raffleId String

  tipo   TipoDePremioDaRaspadinha @default(PIX)
  /// O que aparece para quem ganhou: "R$ 250 no PIX", "Karambit Doppler".
  rotulo String
  /// Em reais, quando o tipo e PIX. Serve para somar quanto ja foi dado.
  valor  Decimal?                 @db.Decimal(10, 2)

  /// Raridade da skin, quando o nome bate com o catalogo do tenant. Nula
  /// quando o premio nao e skin, que e o caso normal de "R$ 250 no Pix" ou de
  /// uma placa de video. So serve para a cor do nome, a mesma leitura que o
  /// jogador ja tem dentro do jogo.
  skinRarity SkinRarity?

  /// Chance em porcentagem. Nulo entra no sorteio uniforme entre os que
  /// tambem nao tem chance definida, igual ao modo RANDOM da caixa.
  chance Decimal? @db.Decimal(5, 2)

  /// Premio guardado: existe no cadastro mas nao sai. Serve para preparar
  /// um premio grande antes de solta-lo.
  travado Boolean @default(false)

  /// QUANDO ESTE PREMIO SAI. Mesma mecanica da caixa surpresa, ver
  /// src/lib/saida.ts: o ponto e promessa, e o premio vai para a PRIMEIRA
  /// raspadinha revelada a partir dele.
  tipoDeSaida TipoDeSaida @default(PROGRESSO)

  /// O ponto de saida, em TITULOS VENDIDOS. So em PROGRESSO. Em titulos e nao
  /// em porcentagem porque porcentagem gravada mudaria de significado se o
  /// total de numeros da campanha mudasse.
  saidaEmTitulos Int?

  /// Condicoes da COMPRA que pode levar. So em PERSONALIZADO.
  saidaTitulosDe  Int?
  saidaTitulosAte Int?
  saidaDataDe     DateTime?
  saidaDataAte    DateTime?
  saidaDdds       String[]

  /// Quando foi levado. Nulo = ainda disponivel.
  claimedAt DateTime?

  raffle             Raffle      @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  raspadinhaQueLevou Raspadinha?

  createdAt DateTime @default(now())

  @@index([raffleId])
  @@index([raffleId, travado, claimedAt])
}

/// Quantos titulos dao quantas raspadinhas.
model RaspadinhaCombo {
  id         String  @id @default(cuid())
  raffleId   String
  /// "A partir de X titulos".
  minimo     Int
  /// "ganha N raspadinhas".
  quantidade Int
  visivel    Boolean @default(true)

  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, minimo])
  @@index([raffleId])
}

/// Um bilhete. Pertence a uma reserva paga.
model Raspadinha {
  id            String           @id @default(cuid())
  raffleId      String
  reservationId String
  status        RaspadinhaStatus @default(DISPONIVEL)

  /// O numero impresso no bilhete, sequencial por sorteio. E identidade
  /// visual, nao chave: quem manda e o id.
  numero Int

  /// 1:1 com o premio levado. Nulo quando a alocacao nao deu premio.
  ///
  /// Decidido na CONFIRMACAO DO PAGAMENTO, igual a caixa surpresa, e nao mais
  /// no primeiro traco da raspagem. Raspar passou a ser so revelacao.
  premioId  String?   @unique
  raspadaEm DateTime?

  /// O estado da decisao deste bilhete. Ver EstadoDaAlocacao.
  alocacao EstadoDaAlocacao @default(PENDENTE)

  /// Quando a alocacao decidiu o destino deste bilhete.
  alocadoEm DateTime?

  /// O intervalo de venda que a compra deste bilhete atravessou.
  vendidosAntes   Int?
  vendidosNaSaida Int?

  raffle      Raffle            @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  reservation Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  premio      RaspadinhaPremio? @relation(fields: [premioId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([raffleId, numero])
  @@index([reservationId])
  @@index([reservationId, alocacao])
  @@index([raffleId, status])
}

// =====================================================================
// RESERVAS E PAGAMENTOS
// =====================================================================

model Reservation {
  id       String  @id @default(cuid())
  raffleId String
  userId   String?

  // Dados do participante (preenchidos mesmo sem conta).
  // Apenas participantName é obrigatório no banco; demais campos são
  // condicionados pelo admin via raffle.requiredFields.
  participantName       String
  participantPhone      String?
  participantCpf        String? // só dígitos
  participantEmail      String?
  participantSocialName String?
  participantBirthDate  DateTime?

  totalAmount      Decimal           @db.Decimal(10, 2)
  /// A reserva saiu com a promocao em dobro valendo.
  ///
  /// Guardado na reserva, e nao recalculado depois: a promocao acaba, e sem
  /// esta marca uma reserva feita durante a janela seria reconstruida com
  /// metade dos numeros se o webhook chegasse atrasado.
  dobroAplicado    Boolean           @default(false)
  /// Um admin marcou esta reserva como paga pelo painel.
  ///
  /// Dinheiro que nao passou pelo gateway: cortesia, pagamento combinado por
  /// fora, teste. Some do relatorio por isso, senao a receita do mes cresce
  /// sem ninguem ter pago nada. Continua PAGA para todo o resto (os titulos
  /// valem, o premio sai, o comprovante existe), e o registro de quem marcou
  /// fica no historico.
  aprovadaNoPainel Boolean           @default(false)
  status           ReservationStatus @default(PENDING)
  expiresAt        DateTime
  paidAt           DateTime?

  affiliateId String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// O canal dentro da campanha ("ads", "instagram-bio", "grupo-whatsapp").
  /// E o que separa "veio do anuncio" de "veio da bio do Instagram" quando
  /// as duas apontam para o mesmo sorteio.
  utmContent  String?

  raffle    Raffle     @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  affiliate Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  tickets        Ticket[]
  xpEntries      XpEntry[]
  payment        Payment?
  commission     AffiliateCommission?
  surpriseBoxes  SurpriseBox[]
  entradasGratis EntradaGratis[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  raspadinhas Raspadinha[]

  @@index([raffleId, status])
  @@index([userId])
  @@index([affiliateId])
  @@index([status, expiresAt]) // job de expiração busca por aqui
}

model Payment {
  id            String          @id @default(cuid())
  reservationId String          @unique
  provider      PaymentProvider
  externalId    String          @unique // id retornado pelo gateway
  status        PaymentStatus
  amount        Decimal         @db.Decimal(10, 2)
  method        PaymentMethod
  rawResponse   Json?
  paidAt        DateTime?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Quanto o gateway cobra por pagamento aprovado.
///
/// Uma linha por FAIXA de valor, porque e assim que eles cobram: ate cem
/// reais um fixo, acima disso um percentual mais outro fixo. Uma linha unica
/// com percentual e fixo nao representaria isso, e a conta do relatorio sairia
/// errada exatamente nas compras grandes, que sao as que pesam.
///
/// A taxa nao e cobrada pela plataforma: ela ja foi descontada pelo gateway
/// antes de o dinheiro cair. O que estas linhas fazem e o relatorio parar de
/// contar como receita um dinheiro que nunca chegou.
model TaxaDeGateway {
  id       String          @id @default(cuid())
  tenantId String
  provider PaymentProvider

  /// A partir de qual valor de compra, em reais, esta faixa vale. Zero e a
  /// faixa base, usada por tudo que nao alcanca uma faixa maior.
  apartirDe  Decimal @default(0) @db.Decimal(10, 2)
  /// Percentual sobre o valor da compra. 2 significa 2%.
  percentual Decimal @default(0) @db.Decimal(6, 3)
  /// Valor fixo somado, em reais. 0.45 e quarenta e cinco centavos.
  fixo       Decimal @default(0) @db.Decimal(10, 2)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider, apartirDe])
  @@index([tenantId, provider])
}

model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  externalId      String // id da TRANSAÇÃO no gateway (Payment.externalId)
  payload         Json
  processedAt     DateTime?
  processingError String?

  createdAt DateTime @default(now())

  // Sem unique aqui: cada transação dispara MÚLTIPLOS eventos ao longo
  // do tempo (created, paid, expired, etc) e queremos logar todos. A
  // idempotência do PROCESSAMENTO é garantida no handler, só atualiza
  // Payment se ainda não estiver em estado terminal.
  @@index([provider, externalId])
  @@index([processedAt])
}

// =====================================================================
// AFILIADOS
// =====================================================================

/// O programa de indicação.
///
/// A recompensa NÃO é dinheiro: a cada R$ 10 efetivamente pagos por quem o
/// afiliado indicou, ele ganha uma Entrada Grátis, que vale uma cota em
/// qualquer campanha, seja ela de R$ 1 ou de R$ 25. Não existe saldo em
/// reais, saque, nem conversão: o benefício é promocional, e é por isso que
/// as colunas de comissão abaixo continuam zeradas e sem uso.
model Affiliate {
  id     String          @id @default(cuid())
  userId String          @unique
  code   String          @unique
  status AffiliateStatus @default(ACTIVE)

  /// O progresso do afiliado rumo ao próximo cupom, em CENTAVOS.
  ///
  /// Soma o que TODOS os indicados dele pagaram: dois indicados com R$ 4 e
  /// R$ 6 fecham os R$ 10 e liberam um cupom. A cada limiar alcançado sai um
  /// cupom e o resto fica guardado, sem perder centavo.
  ///
  /// Pode ficar NEGATIVO depois de um estorno grande: é dívida de progresso,
  /// explícita de propósito, e só o painel administrativo enxerga. Progresso
  /// negativo escondido seria a mesma coisa que perdoar o estorno em silêncio.
  progressoEmCentavos Int @default(0)

  /// COMO A RECOMPENSA É CALCULADA.
  ///
  /// VALOR_FIXO      a cada limiar pago pelos indicados sai um cupom de valor
  ///                 fixo, o mesmo para todo mundo. É o padrão.
  /// PERCENTUAL_PROGRESSIVO
  ///                 o valor do cupom acompanha o quanto AQUELA pessoa
  ///                 indicada já gastou: a cada degrau de gasto dela, o
  ///                 percentual sobe. Quem traz cliente que compra muito
  ///                 ganha mais por ele.
  modoDeRecompensa ModoDeRecompensa @default(VALOR_FIXO)

  /// A cada quantos centavos gastos por UM indicado o percentual sobe um
  /// degrau. Só vale no modo progressivo. Padrão: R$ 100.
  degrauEmCentavos Int @default(10000)
  /// Quanto o percentual sobe por degrau, em basis points. Padrão: 200 = 2%.
  bpsPorDegrau     Int @default(200)

  /// A CONFIGURAÇÃO DE RECOMPENSA DESTE AFILIADO.
  ///
  /// Desligada, valem os padrões globais (lib/afiliados.ts). Ligada, valem
  /// estas três colunas, e elas viajam junto de cada cupom concedido: mudar a
  /// configuração amanhã não pode reescrever o valor de um cupom que já
  /// está na mão de alguém.
  usaConfigPropria       Boolean @default(false)
  /// A cada quantos centavos pagos sai um cupom.
  limiarEmCentavos       Int     @default(1000)
  /// A recompensa em basis points. 5000 = 50%, 7000 = 70%, 10000 = 100%.
  /// Inteiro, nunca float: porcentagem em ponto flutuante erra centavo.
  recompensaEmBps        Int     @default(5000)
  /// O valor de face de cada cupom, em centavos. É derivável do limiar e do
  /// bps, e fica gravado mesmo assim: é ele que o cupom copia, e uma conta
  /// refeita depois de uma migração de arredondamento mudaria o passado.
  valorDoCupomEmCentavos Int     @default(500)

  /// Herança do motor de rifas, sem uso: este programa não paga comissão.
  /// Ficam para não reescrever histórico de instalações antigas.
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)
  totalSales        Decimal @default(0) @db.Decimal(12, 2)
  totalCommission   Decimal @default(0) @db.Decimal(12, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  reservations  Reservation[]
  commissions   AffiliateCommission[]
  indicados     User[]                   @relation("IndicadosDoAfiliado")
  entradas      EntradaGratis[]
  movimentos    MovimentoDeAfiliado[]
  qualificacoes QualificacaoDeIndicado[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Como o cupom do afiliado é dimensionado.
enum ModoDeRecompensa {
  /// Cupom de valor fixo a cada limiar. O padrão, e o que já existia.
  VALOR_FIXO
  /// O percentual sobe com o gasto acumulado de cada pessoa indicada.
  PERCENTUAL_PROGRESSIVO
}

enum AffiliateStatus {
  /// Cadastrado, mas fora do ar: o link não vincula e nada acumula.
  INACTIVE
  ACTIVE
  /// Punido. O histórico e as entradas já ganhas continuam de pé; o que para
  /// é a entrada de gente nova e o acúmulo de progresso.
  SUSPENDED
}

/// Uma Entrada Grátis, uma linha.
///
/// Podia ser um contador na tabela do afiliado, e não é de propósito. Contador
/// não sabe dizer em qual campanha a entrada foi parar, não trava a regra de
/// uma por sorteio, e não tem como ficar reservado enquanto um Pix está
/// pendente. Uma linha por entrada resolve os três: o saldo é quantas estão
/// DISPONIVEL, e a corrida entre duas abas é decidida pelo banco, com
/// FOR UPDATE SKIP LOCKED na hora de pegar uma.
model EntradaGratis {
  id          String                @id @default(cuid())
  affiliateId String
  estado      EstadoDaEntradaGratis @default(DISPONIVEL)

  /// O valor de face do cupom, em CENTAVOS.
  ///
  /// Guardado na linha, e não lido de uma constante, porque cupom é promessa:
  /// mudar a configuração do afiliado amanhã não pode reescrever o valor de um
  /// cupom que já está na mão de alguém.
  ///
  /// Ele abate ATÉ esse valor em UMA cota. Cota mais barata: cobre tudo e o
  /// que sobra se perde, sem troco e sem saldo. Cota mais cara: abate o valor
  /// de face e a pessoa paga a diferença.
  valorEmCentavos Int @default(500)

  /// A configuração que originou este cupom, copiada na concessão. Serve para
  /// auditar por que ele vale o que vale, sem depender do que o afiliado tem
  /// configurado hoje.
  limiarNaConcessao Int @default(1000)
  bpsNaConcessao    Int @default(5000)

  /// Em que campanha ela foi gasta. Nulo enquanto disponível.
  raffleId      String?
  /// Em que compra. Nulo enquanto disponível.
  reservationId String?

  ganhaEm DateTime  @default(now())
  usadaEm DateTime?

  /// ATÉ QUANDO ESTE CUPOM VALE.
  ///
  /// Setenta e duas horas depois da concessão. Nulo é cupom SEM validade, e
  /// não cupom vencido: é assim que ficam os concedidos antes desta regra e
  /// os ajustes manuais do painel, que não deviam morrer sozinhos.
  ///
  /// O vencimento é decidido comparando esta coluna com o relógio, e não por
  /// um estado que alguém precisa vir marcar: sem job que rode, um cupom
  /// vencido continuaria DISPONIVEL e gastável até o job passar.
  expiraEm DateTime?

  affiliate    Affiliate               @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  raffle       Raffle?                 @relation(fields: [raffleId], references: [id], onDelete: SetNull)
  reservation  Reservation?            @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  qualificacao QualificacaoDeIndicado?

  /// UMA POR SORTEIO, GARANTIDO PELO BANCO.
  ///
  /// Entrada disponível tem raffleId nulo, e o Postgres aceita quantos nulos
  /// quiser numa coluna unique: a restrição só morde depois que a entrada é
  /// reservada ou usada. Daí sai exatamente a regra do produto, sem "if" que
  /// duas requisições simultâneas atravessam, e sem tabela extra só para
  /// guardar (usuário, sorteio).
  @@unique([affiliateId, raffleId])
  @@index([affiliateId, estado])
  @@index([affiliateId, estado, expiraEm])
  @@index([reservationId])
}

/// QUANTO CADA PESSOA INDICADA JÁ PAGOU.
///
/// Uma linha por indicado, com o total líquido dele e a data do vínculo. É o
/// que o painel mostra como "compras confirmadas dos seus indicados", e o que
/// diz a partir de quando o dinheiro daquela pessoa conta.
///
/// NÃO É MAIS UM PORTÃO. A regra de "um cupom por pessoa na vida" saiu: a
/// recompensa voltou a ser progressiva e por afiliado, e o mesmo indicado
/// contribui quantas vezes comprar. `qualificadoEm` e `entradaId` ficam como
/// registro daquela época e não são lidos por nenhuma decisão.
model QualificacaoDeIndicado {
  id          String @id @default(cuid())
  affiliateId String
  /// A pessoa indicada. UMA qualificação por pessoa, garantido pelo banco.
  indicadoId  String @unique

  /// Quanto essa pessoa já pagou de verdade, em CENTAVOS, contando só o que
  /// entrou depois do vínculo e descontando estorno. Recalculado a cada
  /// pagamento; não é um acumulador cego.
  pagoEmCentavos Int       @default(0)
  /// LEGADO da regra de um cupom por indicado.
  qualificadoEm  DateTime?
  /// LEGADO da regra de um cupom por indicado.
  entradaId      String?   @unique
  /// Preenchido quando um estorno derrubou o total DEPOIS do cupom ter sido
  /// usado: o cupom não volta (a cota existiu), mas fica registrado, e esta
  /// pessoa continua sem poder gerar outro.
  revertidoEm    DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  affiliate Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  indicado  User           @relation(fields: [indicadoId], references: [id], onDelete: Cascade)
  entrada   EntradaGratis? @relation(fields: [entradaId], references: [id], onDelete: SetNull)

  @@index([affiliateId, qualificadoEm])
}

enum EstadoDaEntradaGratis {
  DISPONIVEL
  /// Presa a uma compra com Pix pendente. Volta a DISPONIVEL se expirar.
  RESERVADA
  USADA
  /// Recolhido por estorno ou por decisão administrativa. Não volta ao saldo,
  /// e fica na tabela: cupom cancelado que some é cupom que ninguém explica.
  CANCELADA
}

/// O histórico do programa, e a fonte da verdade.
///
/// Saldo e progresso existem em coluna por desempenho, mas quem audita lê
/// daqui: quem gerou, quando, por qual compra, quanto acumulou, quando
/// liberou entrada e onde a entrada foi gasta.
model MovimentoDeAfiliado {
  id          String                    @id @default(cuid())
  affiliateId String
  tipo        TipoDeMovimentoDeAfiliado

  /// Dinheiro que entrou (ou saiu, negativo) no progresso, em centavos.
  centavos Int @default(0)
  /// Entradas concedidas (+) ou consumidas (-).
  entradas Int @default(0)

  reservationId String?
  /// Quem comprou. Guardado além da reserva porque reserva pode ser apagada
  /// com a campanha, e o histórico do afiliado não pode sumir junto.
  indicadoId    String?
  raffleId      String?
  descricao     String?
  /// Quem fez, quando o movimento é ajuste manual do painel.
  adminId       String?

  criadoEm DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  /// A trava contra crédito duplo.
  ///
  /// Webhook de pagamento chega mais de uma vez (a SigiloPay entregou o mesmo
  /// evento quatro vezes em dois segundos na primeira transação real). Com
  /// esta restrição, a segunda entrega tenta gravar a mesma linha e o banco
  /// recusa: não é o código que decide, é o índice.
  @@unique([reservationId, tipo])
  @@index([affiliateId, criadoEm])
  @@index([indicadoId])
}

enum TipoDeMovimentoDeAfiliado {
  /// Compra paga de um indicado. Soma centavos ao progresso.
  COMPRA_DE_INDICADO
  /// O progresso fechou R$ 10 e virou entrada.
  ENTRADA_LIBERADA
  /// Entrada gasta numa campanha.
  ENTRADA_USADA
  /// Pix expirou ou compra caiu: a entrada voltou para o saldo.
  ENTRADA_DEVOLVIDA
  /// Estorno/chargeback: desfaz o progresso daquela compra.
  ESTORNO_DE_COMPRA
  /// Ajuste manual do painel, sempre com motivo e responsável.
  AJUSTE
  /// LEGADO: o cupom foi recolhido porque o estorno derrubou o total do
  /// indicado, na regra de um cupom por pessoa.
  QUALIFICACAO_REVERTIDA
  /// Um admin mudou a configuração de recompensa do afiliado.
  CONFIG_ALTERADA
}

model AffiliateCommission {
  id            String           @id @default(cuid())
  affiliateId   String
  reservationId String           @unique
  amount        Decimal          @db.Decimal(10, 2)
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?

  affiliate   Affiliate   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([affiliateId, status])
}

// =====================================================================
// CONFIGURAÇÃO E CONTEÚDO
// =====================================================================

model Bank {
  id             String  @id @default(cuid())
  name           String
  agency         String
  account        String
  pixKey         String?
  holderName     String
  holderDocument String // CPF ou CNPJ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscountLink {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountAmount  Decimal?  @db.Decimal(10, 2)
  validUntil      DateTime?
  maxUses         Int?
  usedCount       Int       @default(0)
  raffleId        String?

  raffle Raffle? @relation(fields: [raffleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([raffleId])
}

model UtmLink {
  id       String  @id @default(cuid())
  label    String
  url      String
  source   String
  medium   String
  campaign String
  raffleId String?

  raffle Raffle? @relation(fields: [raffleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([raffleId])
}

model Webhook {
  id              String    @id @default(cuid())
  url             String
  secret          String
  events          String[] // Postgres array
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Integration {
  id       String  @id @default(cuid())
  provider String  @unique
  config   Json
  enabled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  order    Int     @default(0)
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, order])
}

model Announcement {
  id        String           @id @default(cuid())
  title     String
  content   String           @db.Text
  type      AnnouncementType @default(INFO)
  enabled   Boolean          @default(true)
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, expiresAt])
}

model Contact {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String    @db.Text
  repliedAt DateTime?

  createdAt DateTime @default(now())

  @@index([repliedAt])
}

// Pool de CPFs pré-cadastrados, distribuído automaticamente no
// registerAction, evitando que o usuário precise digitar CPF no cadastro.
// Inserido via migration 20260515000000_add_cpf_pool a partir de uma lista
// curada (559 CPFs com dígitos verificadores válidos). Claim é atômico via
// `FOR UPDATE SKIP LOCKED` no Postgres: dois cadastros simultâneos pegam
// linhas diferentes sem race. Quando o pool esgota, o cadastro continua
// funcionando, o usuário simplesmente fica sem CPF e é solicitado na
// reserva (mesmo fluxo de fallback que já existia).
model CpfPool {
  id             String    @id @default(cuid())
  cpf            String    @unique // 11 dígitos
  assignedUserId String?   @unique
  assignedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([assignedUserId])
}

// Singleton: sempre 1 linha (id = "singleton")
model SiteSettings {
  id                   String    @id @default("singleton")
  logoUrl              String?
  themeMode            ThemeMode @default(LIGHT)
  // Chave do preset de cor (ver ThemePreset em src/lib/theme-presets.ts).
  // Mantida como string em vez de enum pra evitar migration de enum a cada
  // novo preset.
  themePreset          String    @default("orange")
  // Se true, o header do site público pinta no tom do preset; caso contrário
  // usa o background neutro do tema.
  headerAccent         Boolean   @default(false)
  // Cor dos cards de seleção rápida na reserva: "black" | "white" | "accent"
  cardColor            String    @default("black")
  // Personalização da página inicial pública.
  // Strings vazias = não renderiza o cabeçalho da seção.
  homeCampaignsTitle   String    @default("")
  homeCampaignsCaption String    @default("")
  showWinnersOnHome    Boolean   @default(false)
  // Mantidos por compatibilidade, atualmente não usados pelo tema dinâmico
  // (substituídos por themePreset). Permanecem aqui caso futuramente queira
  // permitir cor customizada manual.
  primaryColor         String    @default("#fda92d")
  secondaryColor       String    @default("#71717a")
  companyName          String    @default("Rifa Online")
  // Tagline curta exibida no meta description e em alguns headers
  // ("Sua sorte está aqui", por exemplo).
  siteDescription      String    @default("")
  supportEmail         String?
  supportPhone         String?
  termsOfUse           String?   @db.Text
  privacyPolicy        String?   @db.Text
  aboutUs              String?   @db.Text

  // URL de uma imagem exibida na tela "Pagamento confirmado" como
  // agradecimento ao comprador. Opcional, se vazia, a celebração só
  // mostra o check verde + números.
  thankYouImageUrl String?

  updatedAt DateTime @updatedAt
}

/// De onde a ação partiu. Separado de quem agiu de propósito: a troca do link
/// da Steam tem ator de sessão e origem PUBLICO ao mesmo tempo.
enum LogOrigin {
  PAINEL // alguém clicou no admin
  SISTEMA // webhook de gateway, cron
  PUBLICO // ação do participante no site
}

/// Registro append-only do que aconteceu. O código nunca dá update aqui, e a
/// interface não oferece exclusão; a única escrita destrutiva é a limpeza por
/// idade em activity-log-query.ts.
model ActivityLog {
  id String @id @default(cuid())

  /// Painel a que o registro pertence. Nulo só em evento sem tenant
  /// resolvido, como a varredura global do cron.
  tenantId String?
  tenant   Tenant? @relation("TenantActivityLogs", fields: [tenantId], references: [id], onDelete: Cascade)

  origem LogOrigin @default(PAINEL)

  /// Ator CONGELADO, não por relação, e essa é a decisão central do modelo.
  /// Uma foreign key para User faria o histórico depender de a conta
  /// continuar existindo e com o mesmo nome, quando o caso que mais interessa
  /// é justamente o da conta removida ou renomeada depois do ato.
  actorId    String?
  actorName  String
  actorRole  Role?
  actorEmail String?

  /// Chave do catálogo em src/lib/activity-log-actions.ts.
  acao String

  /// Alvo, para responder "tudo que aconteceu com este sorteio". O rótulo
  /// também é congelado, pelo mesmo motivo do ator.
  alvoTipo   String?
  alvoId     String?
  alvoRotulo String?

  /// { antes, depois } dos campos que mudaram, ou payload curto do evento.
  detalhes Json?

  ip String?

  criadoEm DateTime @default(now())

  @@index([tenantId, criadoEm])
  @@index([alvoTipo, alvoId])
  @@index([acao, criadoEm])
  @@index([actorId, criadoEm])
  /// criadoEm sozinho, e não só como segunda coluna dos compostos: a limpeza
  /// varre por data sem filtro nenhum, e a vista do dono da plataforma ordena
  /// sem filtro de tenant. Postgres não faz skip scan, então índice composto
  /// com criadoEm na segunda posição não serve para nenhum dos dois.
  @@index([criadoEm])
}

/// O sorteio ao vivo de uma campanha.
///
/// Existe porque o resultado passou a ser decidido pelo sistema, e não mais
/// digitado no painel. A linha guarda três coisas que antes não existiam em
/// lugar nenhum: o CRONOGRAMA (quando cada fase acontece), o RESULTADO
/// (número, dono, e a hora em que o motor escolheu) e a PROVA (quantos
/// bilhetes disputaram, o método de sorteio e a impressão digital do universo
/// que disputou).
///
/// O cronograma é gravado inteiro no instante do encerramento, e não fase a
/// fase. É isso que dispensa um servidor de eventos: quem abre a página não
/// precisa ser avisado de que a contagem começou, ele já tem a hora e conta
/// sozinho. E é isso que faz o sistema sobreviver a um restart no meio da
/// transmissão: o estado não estava na memória de ninguém.
model Draw {
  id String @id @default(cuid())

  /// O código que aparece no comprovante e na URL: DRW-20260829-8F2C. Público
  /// de propósito: é ele que a pessoa compartilha, e por isso o `id` interno
  /// nunca aparece na tela.
  publicId String @unique

  /// Um sorteio oficial por campanha, garantido aqui. Dois seriam dois
  /// ganhadores para o mesmo prêmio, e a corrida que cria o segundo é
  /// exatamente o que acontece quando dois workers acordam juntos.
  raffleId String @unique
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  status DrawStatus @default(WAITING_DRAW)

  // ----------------------------------------------------- cronograma
  /// Quando a campanha encerrou. A origem de todo o resto.
  raffleEndedAt   DateTime
  /// Quando a contagem regressiva começa.
  drawScheduledAt DateTime
  /// Quando a contagem zera e o motor sorteia.
  drawStartsAt    DateTime
  /// Quando o número pode ser mostrado.
  revealAt        DateTime
  /// Quando o nome do ganhador pode ser mostrado.
  winnerRevealAt  DateTime

  // ------------------------------------------------- o que de fato ocorreu
  /// Primeira vez que alguém observou a contagem em curso. Fica nulo se o
  /// sistema esteve fora do ar durante os sessenta segundos, e essa ausência
  /// é informação: diz que ninguém viu a contagem.
  countdownStartedAt DateTime?
  /// O instante em que o número foi escolhido. É o carimbo do resultado.
  drawExecutedAt     DateTime?
  /// O instante em que o ganhador virou público.
  winnerRevealedAt   DateTime?
  finishedAt         DateTime?

  // ----------------------------------------------------------- resultado
  winningNumber  Int?
  winnerTicketId String?
  winnerUserId   String?
  /// Nome CONGELADO do ganhador, pelo mesmo motivo do ActivityLog: o
  /// comprovante precisa continuar dizendo quem ganhou mesmo que a conta seja
  /// renomeada ou apagada depois. Guardado já encurtado, no formato que vai
  /// para a tela; nome completo não é dado de vitrine.
  winnerName     String?

  // -------------------------------------------------------------- prova
  //
  // O que permite qualquer pessoa refazer o sorteio no próprio navegador. A
  // matemática vive em src/lib/sorteio-justo.ts; aqui ficam só os valores.
  //
  /// Quantos títulos disputaram. É o denominador da chance de cada um.
  eligibleTicketCount Int    @default(0)
  /// Como o número foi escolhido, escrito por extenso no comprovante.
  rngMethod           String @default("hmac-sha256 (compromisso e revelação)")
  /// Versão do motor. 1 era o sorteio por crypto.randomInt, sem como
  /// conferir; 2 é o verificável. Um sorteio antigo precisa continuar
  /// explicável pela regra que valia quando ele rodou.
  drawVersion         Int    @default(2)

  /// Cópia do compromisso publicado antes da primeira venda (ver DrawSeed).
  serverSeedHash String?
  /// SHA-256 do manifesto: os títulos elegíveis, em ordem, um por linha.
  clientSeed     String?
  /// Contador do sorteio dentro da campanha. Hoje sempre 1.
  nonce          Int     @default(1)
  /// Posição sorteada dentro do manifesto.
  winnerIndex    Int?
  /// O HMAC inteiro, para quem quiser conferir dígito a dígito.
  hmacHex        String?

  /// Por que falhou, quando falhou. Só preenchido em ERROR.
  errorReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// O worker procura por "o que está pendente e já passou da hora". Este é
  /// o índice dessa pergunta.
  @@index([status, drawScheduledAt])
  @@index([status, drawStartsAt])
}

/// A semente secreta do sorteio, comprometida antes da primeira venda.
///
/// Fica numa tabela própria, e não em colunas do Raffle, por uma razão de
/// segurança concreta: meia dúzia de lugares deste código fazem
/// `raffle.findUnique` sem `select` e entregam a linha inteira para um
/// componente de cliente. Uma coluna secreta ali dentro iria para o navegador
/// no primeiro desses caminhos, em silêncio. Numa tabela separada, vazar exige
/// alguém escrever `drawSeed` de propósito.
///
/// O compromisso (`serverSeedHash`) é público desde o primeiro dia e aparece
/// na página da campanha. A semente em si só é publicada depois que o número
/// vencedor já é público, e `revealedAt` é o carimbo desse momento.
/// Os times de CS2 para quem o participante torce.
///
/// Nasceu como constante em src/lib/times-cs2.ts, e a lista fixa em código
/// estava certa enquanto ninguém precisava mexer nela. Passou a estar errada
/// quando o pedido virou "quero enviar o escudo e adicionar times novos":
/// isso é cadastro, e cadastro não mora em deploy.
///
/// O `id` continua sendo o slug, o mesmo que já está gravado em
/// User.favoriteTeamId. Manter a mesma chave é o que faz a migração ser só
/// mudar de onde a lista é lida, sem tocar em conta nenhuma.
model Team {
  /// Slug. É o que User.favoriteTeamId guarda.
  id     String  @id
  nome   String
  /// Duas a quatro letras. É o que o emblema mostra quando não há escudo.
  tag    String
  /// Acento do emblema de reserva, em hex de seis dígitos.
  cor    String
  regiao String
  /// URL do escudo no Storage. Vazio cai no emblema de iniciais.
  escudo String?
  /// Ordem na lista. Empate desfeito pelo nome.
  ordem  Int     @default(0)
  /// Time desativado some do seletor mas NÃO é apagado: quem já torcia por ele
  /// continua com o id na conta, e o emblema continua desenhando.
  ativo  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo, regiao, ordem])
}

model DrawSeed {
  raffleId String @id
  raffle   Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  /// SEGREDO até a revelação. Nunca sai de um endpoint antes disso.
  serverSeed     String
  /// SHA-256 da semente. Publicado desde a criação da campanha.
  serverSeedHash String

  committedAt DateTime  @default(now())
  revealedAt  DateTime?
}
