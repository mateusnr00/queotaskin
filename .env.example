# ============================================================================
# QuéOta Skin — variáveis de ambiente
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env (está no .gitignore).
# ============================================================================

# ---------- Banco de dados (Supabase Postgres) ----------
# Encontre em: Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL = string com pooler (Transaction mode, porta 6543) — usada pelo app
# DIRECT_URL   = string sem pooler (porta 5432) — usada pelo Prisma para migrations
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------- Supabase Storage (upload de imagens) ----------
# Encontre em: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="raffle-images"

# ---------- Auth.js (NextAuth v5) ----------
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
# URL pública da app (em dev = http://localhost:3000)
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ---------- Admin inicial (usado pelo seed.ts) ----------
# Login do sistema é por NOME + CELULAR (passwordless, sem senha).
# Coloque um celular com DDD (10 ou 11 dígitos) e o nome completo que
# você vai digitar pra entrar no admin.
SEED_ADMIN_PHONE="11999999999"
SEED_ADMIN_NAME="Administrador"
# E-mail é opcional — só dado de contato.
SEED_ADMIN_EMAIL=""

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="QuéOta Skin"
# URL base do site público (onde os clientes veem campanhas).
# Ex.: produção = "https://queotaskin.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Host do painel admin. Em produção o app roda como dois sites distintos:
# queotaskin.com serve o frontend e admin.queotaskin.com serve o /admin (o
# proxy redireciona /admin* pra cá e bloqueia rotas públicas no host admin).
# Default já é "admin.queotaskin.com" — só preencha pra sobrescrever em
# white-labels ou ambientes paralelos. Em dev/preview deixe vazio.
NEXT_PUBLIC_ADMIN_HOST=""

# ---------- Mercado Pago (Fase 2 — deixar vazio por enquanto) ----------
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# ---------- SyncPay (gateway Pix) ----------
# Pegue em https://app.syncpayments.com.br/seller/developer-api
SYNCPAY_CLIENT_ID=""
SYNCPAY_CLIENT_SECRET=""
# Opcional — segredo aleatório usado como parte do path do webhook
# pra evitar que qualquer pessoa chame seu endpoint. Ex: openssl rand -hex 24
SYNCPAY_WEBHOOK_TOKEN=""
# Opcional — host da API. Default: https://api.syncpayments.com.br
# Sobrescreva se o seu painel SyncPay mostrar outro host.
SYNCPAY_BASE_URL=""

# ---------- HorsePay (gateway Pix) ----------
# As credenciais (client key, client secret e o segredo do webhook) ficam no
# painel admin, em Configuracoes, Pagamentos, e sao gravadas cifradas no banco.
# Aqui vai so o token que compoe o caminho do webhook, que e por ambiente.
# Ex: openssl rand -hex 24
HORSEPAY_WEBHOOK_TOKEN=""

# ---------- Inngest (Fase 1 stub — preencher quando criar conta) ----------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---------- Resend (Fase 2) ----------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@rifa.local"

# ---------- Upstash Redis (rate limit) ----------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- react-grab (opcional, só desenvolvimento) ----------
# Ligue com "1" para carregar o inspetor de elementos do react-grab pelo CDN.
# Fica desligado por padrão: é preferência de quem está na máquina, não do
# projeto. Ignorado fora de NODE_ENV=development.
REACT_GRAB=""

# ---------- Câmbio (PTAX do Banco Central, AwesomeAPI de retaguarda) ----------
# Cada entrega guarda o câmbio de VENDA do dia em que ela saiu, e a fonte
# usada. PTAX primeiro, porque é a taxa oficial; a AwesomeAPI entra quando o
# Banco Central não publica aquela moeda ou está fora do ar.
#
# O Olinda (Banco Central) é aberto e não pede nada. O token da AwesomeAPI é
# OPCIONAL: sem ele a resposta vem de cache de um minuto, o que para
# fechamento de dia anterior dá no mesmo. Pegue em awesomeapi.com.br.
AWESOMEAPI_TOKEN=""

# ---------- Preço de referência da skin (opcional) ----------
# O painel consulta o Mercado da Comunidade Steam para sugerir o preço da cota.
# A rota é pública e não pede chave, então normalmente não há nada a configurar.
#
# Esta variável é uma COSTURA: aponta a consulta para um espelho ou para um
# dublê, útil para verificar a tela sem depender de a Steam estar alcançável.
# Vazia, vale o endereço real da Steam.
STEAM_MARKET_BASE_URL=""
ADMIN_MFA_ENCRYPTION_KEY="gere-com-node--e-crypto-randomBytes-32-base64-DIFERENTE-da-payment-key"
