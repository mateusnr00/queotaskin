{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "buildCommand": "node scripts/migrate-deploy.mjs && npm run build",
  "crons": [
    {
      "path": "/api/cron/expire-reservations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sorteios",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/reconciliar-pagamentos",
      "schedule": "*/2 * * * *"
    }
  ]
}
